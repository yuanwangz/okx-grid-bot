# OKX API配置
# 请替换为您的OKX API密钥信息
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=


# PushPlus通知的Token，用于发送交易通知或警报
PUSHPLUS_TOKEN = "your_pushplus_token_here"

# Telegram Bot配置
# 从BotFather获取的Bot Token
TELEGRAM_BOT_TOKEN = "your_telegram_bot_token_here"
# 你的Telegram用户ID或群组ID(必须先与机器人私聊一次)
TELEGRAM_CHAT_ID = "your_telegram_chat_id_here"

# 初始基准价格，用于计算买入/卖出时的价格参考
INITIAL_BASE_PRICE = 600.0

# 初始本金，用于计算总盈亏和盈亏率
INITIAL_PRINCIPAL = 1000.0

# 交易对配置
BASE_SYMBOL = 'OKB'  # 基础币种
QUOTE_SYMBOL = 'USDT'  # 计价币种

# 测试/实盘模式
FLAG = 1 # 0为实盘，1为模拟

# 网格交易配置
INITIAL_GRID = 2.0  # 初始网格大小（百分比）
MIN_TRADE_AMOUNT = 20.0  # 最小交易金额（USDT）

# 仓位控制
MAX_POSITION_RATIO = 0.9  # 最大仓位比例（90%），保留10%底仓
MIN_POSITION_RATIO = 0.1  # 最小仓位比例（10%），底仓

# 风险管理参数
MAX_DRAWDOWN = -0.15  # 最大回撤限制（-15%）
DAILY_LOSS_LIMIT = -0.05  # 每日亏损限制（-5%）

# Web界面配置
WEB_PASSWORD = "admin123"  # Web界面登录密码

